<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Client.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Client.Views.CustomersView"
             x:DataType="vm:CustomersViewModel"
             Background="{DynamicResource PrimaryBackgroundColor}"
             Foreground="{DynamicResource PrimaryTextColor}">

  <Design.DataContext>
    <vm:CustomersViewModel></vm:CustomersViewModel>
  </Design.DataContext>

  <StackPanel>
    <TextBlock Classes="h2" Text="Våra kunder" FontSize="30" />

    <Border BorderBrush="White" BorderThickness="0 0 0 1" Padding="0 0 0 5">
      <Grid ColumnDefinitions="100 150 400 * 30 ">
        <Label Content="Förnamn"/>
        <Label Grid.Column="1" Content="Efternamn"/>
        <Label Grid.Column="2" Content="Email"/>
      </Grid>
    </Border>

      <ItemsControl ItemsSource="{Binding Customers}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="100 150 400 * 30 ">
                <Label Content="{Binding FirstName}"/>
                <Label Grid.Column="1" Content="{Binding LastName}"/>
                <Label Grid.Column="2" Content="{Binding Email}" /> 
                <Button Grid.Column="3" Command="{Binding Edit}" FontFamily="{DynamicResource IconFont}" Foreground="LightGreen" Content="&#xE3AE;" Padding="10 0 0 2" HorizontalAlignment="Right" />
                <Button Grid.Column="4" Command="{Binding Delete}" FontFamily="{DynamicResource IconFont}" Foreground="Red" Content="&#xe4a6;" Padding="10 0 0 2" HorizontalAlignment="Right" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
   </StackPanel>


</UserControl>
